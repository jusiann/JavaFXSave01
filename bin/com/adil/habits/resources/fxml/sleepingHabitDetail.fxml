<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="200.0" prefWidth="200.0" spacing="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adil.habits.controllers.SleepingHabitDetailController">
    <VBox prefHeight="70.0" prefWidth="50.0" spacing="5">
        <Label text="Saat:" />
        <ComboBox fx:id="hourBox" />
    </VBox>
   <Pane prefHeight="160.0" prefWidth="65.0">
      <children>
         <Button fx:id="btnApply" layoutX="-6.0" layoutY="80.0" onAction="#applyChanges" text="Uygula" />
         <Button fx:id="btnDelete" layoutX="6.0" layoutY="121.0" onAction="#deleteHabit" text="Sil" />
      </children>
   </Pane>
    <VBox spacing="5">
    
              <Label text="Dakika:" />
        <ComboBox fx:id="minuteBox" />
    </VBox>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</HBox>
