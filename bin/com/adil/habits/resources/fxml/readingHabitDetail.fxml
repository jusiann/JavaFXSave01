<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="200.0" prefWidth="210.0" spacing="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adil.habits.controllers.ReadingHabitDetailController">
    <Label text="Detay Türü:" />
    <ComboBox fx:id="readingTypeBox" />
    
    <Label text="Değer:" />
    <TextField fx:id="readingField" />
    
    <Button fx:id="btnApply" onAction="#applyChanges" text="Uygula" />
    <Button fx:id="btnDelete" onAction="#deleteHabit" text="Sil" />
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
